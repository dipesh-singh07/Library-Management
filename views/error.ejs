<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Error' %> | Library Portal</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f1117;
            color: #e8e4d8;
            font-family: 'Georgia', serif;
            padding: 2rem;
        }
        .error-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 16px;
            padding: 3rem 2.5rem;
            max-width: 520px;
            width: 100%;
            text-align: center;
        }
        .error-icon { font-size: 3.5rem; margin-bottom: 1rem; }
        .error-title {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            color: #f5c76e;
        }
        .error-message {
            color: #a8a49a;
            line-height: 1.7;
            margin-bottom: 2rem;
        }
        .error-back {
            display: inline-block;
            padding: 0.65rem 1.5rem;
            background: #f5c76e;
            color: #1a1106;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: opacity 0.2s;
        }
        .error-back:hover { opacity: 0.85; }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="error-icon">📚</div>
        <h1 class="error-title"><%= typeof title !== 'undefined' ? title : 'Something went wrong' %></h1>
        <p class="error-message">
            <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred. Please try again or contact the librarian.' %>
        </p>
        <a href="javascript:history.back()" class="error-back">← Go Back</a>
    </div>
</body>
</html>
